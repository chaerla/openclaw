# Copy to .env and fill with your values.

# --- Twilio (WhatsApp) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# Must be a WhatsApp-enabled Twilio number, prefixed with whatsapp:
TWILIO_WHATSAPP_FROM=whatsapp:+17343367101

# --- Email gateway (Docker: scripts/docker/setup-email-gateway.sh) ---
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
BOT_EMAIL=
OPENCLAW_GATEWAY_TOKEN=
# At least one required for the agent (default model is openai/gpt-4o)
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
